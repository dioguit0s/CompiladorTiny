options {
    STATIC = false;
}

PARSER_BEGIN(Tiny)

package com.mycompany.tiny.compiler;

import java.util.*;

public class Tiny {

    private List<String> erros = new ArrayList<String>();

    private Map<String,Boolean> tabela = new HashMap<String,Boolean>();

    public List<String> getErros() {
        return erros;
    }

    public void declarar(Token id) {
        if (tabela.containsKey(id.image)) {
            erros.add("Linha " + id.beginLine + ", coluna " + id.beginColumn + ": '" + id.image + "' já foi declarada.");
        } else {
            tabela.put(id.image, false);
        }
    }

    public void definir(Token id) {
        if (!tabela.containsKey(id.image)) {
            erros.add("Linha " + id.beginLine + ", coluna " + id.beginColumn + ": '" + id.image + "' não foi declarada.");
        } else {
            tabela.put(id.image, true);
        }
    }

    public void usar(Token id) {
        if (!tabela.containsKey(id.image)) {
            erros.add("Linha " + id.beginLine + ", coluna " + id.beginColumn + ": '" + id.image + "' não foi declarada.");
        } else if (!tabela.get(id.image)) {
            erros.add("Linha " + id.beginLine + ", coluna " + id.beginColumn + ": '" + id.image + "' não tem valor.");
        }
    }
}

PARSER_END(Tiny)

SKIP : { " " | "\t" | "\n" | "\r" }

SPECIAL_TOKEN : { < COMMENT: "{" (~["}"])* "}" > }

TOKEN : {
    < INT: "int" >
  | < IF: "if" >
  | < THEN: "then" >
  | < ELSE: "else" >
  | < END: "end" >
  | < REPEAT: "repeat" >
  | < UNTIL: "until" >
  | < READ: "read" >
  | < WRITE: "write" >
  | < NUM: (["0"-"9"])+ | (["0"-"9"])+ "." (["0"-"9"])+ >
  | < ID: ["a"-"z","A"-"Z"] ( ["a"-"z", "A"-"Z", "0"-"9"] )*>
  | < ATRIB: ":=">
  | < SOM: "+">
  | < SUB: "-">
  | < MULT: "*">
  | < DIV: "/">
  | < ABREPARE: "(">
  | < FECHAPARE: ")">
  | < MENOR: "<">
  | < MAIOR: ">">
  | < IGUAL: "=">
  | < VIRGULA: ",">
  | < PONTOVIRGULA: ";">
}

void Programa() :
{}
{
    (Declaracao())* SequenciaComandos() <EOF>
}

private void Declaracao():
{Token id;}
{
    <INT> id=<ID> {declarar(id);} (<VIRGULA> id=<ID> {declarar(id);})* <PONTOVIRGULA>
}

private void SequenciaComandos():
{}
{
    Instrucao() (<PONTOVIRGULA> Instrucao())*
}

private void Instrucao():
{}
{
    Atribuicao()
  | ComandoRepeat()
  | ComandoIf()
  | ComandoRead()
  | ComandoWrite()
}

private void Atribuicao():
{Token id;}
{
    id=<ID> <ATRIB> Expressao()
    {definir(id);}
}

private void ComandoRepeat():
{}
{
    <REPEAT> SequenciaComandos() <UNTIL> Comparacao()
}

private void ComandoIf():
{}
{
    <IF> Comparacao() <THEN> SequenciaComandos() [ <ELSE> SequenciaComandos() ] <END>
}

private void Comparacao():
{}
{
    Expressao() (<MENOR> | <MAIOR> | <IGUAL>) Expressao()
}

private void ComandoRead():
{Token id;}
{
    <READ> id=<ID>
    {definir(id);}
}

private void ComandoWrite():
{}
{
    <WRITE> Expressao()
}

private void Expressao():
{}
{
    Termo()
    ((<SOM> | <SUB>) Termo())*
}

private void Termo():
{}
{
    Fator()
    ((<MULT> | <DIV>) Fator())*
}

private void Fator():
{Token id;}
{
    id=<ID> {usar(id);}
  | <NUM>
  | <ABREPARE> Expressao() <FECHAPARE>
}
